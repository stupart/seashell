{
  "name": "seashell",
  "version": "1.1.0",
  "license": "MIT",
  "module": "src/cli.tsx",
  "type": "module",
  "private": true,
  "bin": {
    "seashell": "./src/cli.tsx"
  },
  "scripts": {
    "start": "bun run src/cli.tsx",
    "dev": "bun --watch src/cli.tsx",
    "test": "bun test ./test && python3 -m unittest discover -s test -p '*_test.py'",
    "typecheck": "bunx tsc --noEmit",
    "gym": "bun run scripts/gym.ts",
    "benchmark:live-asr": "bun run scripts/benchmark-live-asr.ts",
    "ci": "node scripts/local-ci.mjs",
    "ci:quick": "node scripts/local-ci.mjs --quick",
    "ci:verify": "node scripts/local-ci.mjs --verify",
    "ci:hook": "node scripts/local-ci.mjs --install-hook"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.10.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/react": "^19.2.7",
    "ink": "^6.5.1",
    "react": "^19.2.1"
  }
}
