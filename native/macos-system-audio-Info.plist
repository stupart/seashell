<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>com.humain.seashell.system-audio</string>
  <key>CFBundleName</key>
  <string>Seashell System Audio</string>
  <!-- Bump only when the PCM/event contract changes: a new protocol replaces
       the installed copy, and macOS then asks for System Audio Recording again. -->
